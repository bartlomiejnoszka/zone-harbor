MCP_HOST=mcp.example.com
MCP_LOCAL_PORT=8080
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
# Use the actual dedicated proxy network CIDR. Empty means forwarded headers are not trusted.
TRUSTED_PROXIES=
MCP_SECRETS_DIR=./secrets
