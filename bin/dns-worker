#!/usr/bin/env php
<?php

declare(strict_types=1);

use OvhDns\Configuration;
use OvhDns\Infrastructure\DnsServiceFactory;
use OvhDns\Operation\WriteExecutor;
use OvhDns\Tui\Worker;

require dirname(__DIR__).'/vendor/autoload.php';

try {
    umask(0077);
    Configuration::initialize(dirname(__DIR__));
    $request = json_decode(stream_get_contents(STDIN), true, flags: JSON_THROW_ON_ERROR);
    if (!is_array($request)) throw new InvalidArgumentException();
    $dns = DnsServiceFactory::create();
    // Same directory and lock resource as MCP, including existing operation history.
    $result = (new Worker($dns, new WriteExecutor($dns, Configuration::operationDirectory())))->handle($request);
} catch (Throwable) {
    $result = ['status' => 'failed', 'error' => 'Cannot initialize the DNS worker. Check local configuration.'];
}
fwrite(STDOUT, json_encode($result, JSON_INVALID_UTF8_SUBSTITUTE | JSON_THROW_ON_ERROR));
