#!/usr/bin/env php
<?php

declare(strict_types=1);

use OvhDns\Configuration;

require dirname(__DIR__).'/vendor/autoload.php';

try {
    Configuration::loadEnvironment(dirname(__DIR__));
    $directory = dirname(__DIR__).'/secrets';
    $values = [];
    foreach (['OVH_APPLICATION_KEY', 'OVH_APPLICATION_SECRET', 'OVH_CONSUMER_KEY'] as $name) {
        $values[strtolower($name)] = getenv($name) !== false ? getenv($name) : ($_ENV[$name] ?? '');
        if ($values[strtolower($name)] === '') throw new RuntimeException('Configure OVH credentials first.');
    }
    $values['mcp_http_token'] = bin2hex(random_bytes(32));
    $values['app_secret'] = bin2hex(random_bytes(32));
    umask(0077);
    if (!is_dir($directory) && !mkdir($directory, 0700)) throw new RuntimeException('Cannot create directory.');
    foreach ($values as $name => $value) {
        $file = $directory.'/'.$name;
        if (is_file($file)) continue; // Never rotate existing access or overwrite credentials implicitly.
        $handle = fopen($file, 'xb');
        if ($handle === false) throw new RuntimeException('Cannot save secret.');
        try {
            if (fwrite($handle, $value."\n") !== strlen($value) + 1) throw new RuntimeException('Cannot save secret.');
        } finally { fclose($handle); }
        // Compose bind-mounts files without remapping uid/gid. The private 0700
        // parent protects host access; 0444 permits the non-root container to read.
        if (!chmod($file, 0444)) throw new RuntimeException('Cannot set secret permissions.');
    }
    fwrite(STDOUT, "Docker secret files prepared in secrets/. Existing files were preserved; no values printed.\n");
} catch (Throwable) {
    fwrite(STDERR, "Cannot prepare Docker secrets. Check configuration and file permissions.\n");
    exit(1);
}
