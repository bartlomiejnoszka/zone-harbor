{
    "name": "bartlomiejnoszka/zone-harbor",
    "description": "DNS management and domain health from your terminal",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4.1",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "mikepultz/netdns2": "^2.0",
        "ovh/ovh": "^3.5",
        "symfony/cache": "8.2.*@dev",
        "symfony/cache-contracts": "^3.8@dev",
        "symfony/config": "8.2.*@dev",
        "symfony/console": "8.2.*@dev",
        "symfony/dependency-injection": "8.2.*@dev",
        "symfony/dotenv": "8.2.*@dev",
        "symfony/error-handler": "8.2.*@dev",
        "symfony/event-dispatcher": "8.2.*@dev",
        "symfony/event-dispatcher-contracts": "^3.8@dev",
        "symfony/framework-bundle": "8.2.*@dev",
        "symfony/http-foundation": "8.2.*@dev",
        "symfony/http-kernel": "8.2.*@dev",
        "symfony/lock": "8.2.*@dev",
        "symfony/mcp-bundle": "~1.0.0@beta",
        "symfony/process": "8.2.*@dev",
        "symfony/property-access": "8.2.*@dev",
        "symfony/property-info": "8.2.*@dev",
        "symfony/psr-http-message-bridge": "8.2.*@dev",
        "symfony/routing": "8.2.*@dev",
        "symfony/security-bundle": "8.2.*@dev",
        "symfony/security-core": "8.2.*@dev",
        "symfony/security-csrf": "8.2.*@dev",
        "symfony/security-http": "8.2.*@dev",
        "symfony/service-contracts": "^3.8@dev",
        "symfony/string": "8.2.*@dev",
        "symfony/tui": "8.2.*@dev",
        "symfony/type-info": "8.2.*@dev",
        "symfony/uid": "8.2.*@dev",
        "symfony/var-dumper": "8.2.*@dev",
        "symfony/var-exporter": "8.2.*@dev",
        "symfony/yaml": "8.2.*@dev"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "OvhDns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OvhDns\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "check": [
            "@composer validate --strict",
            "@analyse",
            "@test"
        ],
        "analyse": "phpstan analyse --no-progress",
        "test:snapshots": "phpunit tests/TuiSnapshotTest.php",
        "snapshots:update": "UPDATE_TUI_SNAPSHOTS=1 phpunit tests/TuiSnapshotTest.php"
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true,
        "allow-plugins": {}
    },
    "prefer-stable": true
}
